# Example environment variables. Copy to .env and fill in real values.
# NEVER commit .env to the repo.

# ── Edge agent ──────────────────────────────────
EDGE_API_TOKEN=change-me-to-a-random-token
EDGE_HOST=0.0.0.0
EDGE_PORT=8001
LLAMA_CPP_HOST=127.0.0.1
LLAMA_CPP_PORT=8080

# ── Gateway ─────────────────────────────────────
GATEWAY_API_TOKEN=change-me-to-a-random-token
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# ── AWS (only on laptop, never on Jetson) ───────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-south-1
# AWS_S3_BUCKET=
# AWS_DYNAMODB_TABLE=

# ── Telemetry (outbox → cloud) ──────────────────
TELEMETRY_ENDPOINT=https://your-api-gateway.amazonaws.com/prod/telemetry
TELEMETRY_API_KEY=change-me
